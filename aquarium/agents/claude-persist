#!/bin/bash
# claude-persist — Claude Code sessions on this Pi that survive SSH drops AND
# reboots, with their own context restored. Every instance runs `claude --rc`
# (Remote Control: visible in the app / COD bus) inside a detached tmux session,
# restarted if it exits. Started at boot by claude-rc.service (user unit, linger).
#
# Many instances can coexist: each has a NAME, its own tmux session, its own
# cwd, and its own pinned session id in ~/.claude-persist/<name>.sid. On every
# (re)start an instance resumes ITS session id if the transcript exists, else
# starts a new session pinned to that id. Instances never resume each other.
#
#   claude-persist [name]            attach (creates if missing)   default name: claude
#   claude-persist start [name]      ensure running, stay detached
#   claude-persist stop [name]       kill it (its session id is kept)
#   claude-persist status [name]
#   claude-persist list              all known instances
#   claude-persist reset [name]      forget the pinned session id (next start = fresh)
# Env: CLAUDE_PERSIST_CWD (cwd for a new instance; default $HOME for "claude",
#      else $HOME/<name>), CLAUDE_BIN (default claude).
export PATH="$HOME/.local/bin:$HOME/.npm-global/bin:/usr/local/bin:$PATH"
D="$HOME/.claude-persist"; mkdir -p "$D"

# Resolve the claude binary instead of assuming a path. It was pinned to
# /usr/local/bin/claude to stop a ~/.local/bin/claude wrapper from recursing
# into the restart loop -- but the native installer puts claude in
# ~/.local/bin, so on those boxes the pin made the agent crash-loop forever
# with "No such file or directory". Found on neuralgrid.
# Order: explicit override, then the npm/global path, then the user path,
# then PATH. A wrapper at any of these exec's the real binary, so no recursion.
resolve_claude() {
  [ -n "${CLAUDE_BIN:-}" ] && { printf '%s' "$CLAUDE_BIN"; return; }
  local c
  for c in /usr/local/bin/claude "$HOME/.local/bin/claude" "$HOME/.npm-global/bin/claude"; do
    [ -x "$c" ] && { printf '%s' "$c"; return; }
  done
  c="$(command -v claude 2>/dev/null)"
  [ -n "$c" ] && { printf '%s' "$c"; return; }
  printf 'claude'   # last resort; the loop will log a clear failure
}

say() { printf '%s\n' "$*"; }
cmd="${1:-attach}"
case "$cmd" in -h|--help|help) sed -n '2,30p' "$0"; exit 0 ;; esac
case "$cmd" in attach|stream|start|start-all|stop|status|reset|list|restart|fresh|_loop) shift ;; *) cmd=attach ;; esac
N="${1:-claude}"
# Reject anything flag-shaped as a name. `claude-persist --help` previously
# fell through to the name slot and REGISTERED an agent called "--help" with a
# cwd of ~/--help. A typo must not create an agent.
case "$N" in -*) echo "not an agent name: $N (did you mean a subcommand?)" >&2; exit 2 ;; esac
[[ "$N" =~ ^[A-Za-z0-9_.-]+$ ]] || { echo "bad name: $N" >&2; exit 2; }

cwd_for() {  # remembered per instance; first start fixes it
  if [ -s "$D/$N.cwd" ]; then cat "$D/$N.cwd"; return; fi
  local c="${CLAUDE_PERSIST_CWD:-}"
  [ -z "$c" ] && { [ "$N" = claude ] && c="$HOME" || c="$HOME/$N"; }
  mkdir -p "$c"; echo "$c" > "$D/$N.cwd"; echo "$c"
}

# runs inside tmux, loops forever
run_loop() {
  N="$1"
  cd "$(cwd_for)" || exit 1
  while true; do
    [ -s "$D/$N.sid" ] || cat /proc/sys/kernel/random/uuid > "$D/$N.sid"
    sid="$(cat "$D/$N.sid")"
    if ls "$HOME"/.claude/projects/*/"$sid".jsonl >/dev/null 2>&1; then
      echo "[claude-persist:$N] resuming $sid"
      # -n matters: without it the app shows a derived name instead of this
      # instance's name, and you cannot tell which agent you are looking at.
      # A resumed agent that is handed nothing does nothing, so it never
      # registers activity and does not appear in the app until a human or
      # another agent speaks to it. After the 2026-10-06 reboot this one sat
      # silent and invisible for 7 minutes. Hand it a short opening task so
      # it announces itself. Override per agent in $D/$N.resumeprompt.
      rp="$(cat "$D/$N.resumeprompt" 2>/dev/null)"
      [ -n "$rp" ] || rp="You just came back from a restart with your context intact. Briefly: confirm what this node is and that its services are up, announce yourself on the bus if this node is in a tank, then carry on with whatever you were doing."
      $(resolve_claude) --rc --resume "$sid" -n "$(cat "$D/$N.title" 2>/dev/null || echo "$N")" "$rp"
    else
      echo "[claude-persist:$N] new session $sid"
      # A fresh agent with no opening prompt is a dead agent: it sits at the
      # prompt forever with nobody to tell it to read its own handoff. That
      # happened on 2026-10-05 -- a context roll at the 09:00 reboot left this
      # agent idle for 7.7 h. The boot prompt is what makes a rolled context
      # survivable. Override per instance in $D/$N.bootprompt.
      bp="$(cat "$D/$N.bootprompt" 2>/dev/null)"
      [ -n "$bp" ] || bp="You are the $N agent on this node, waking with no prior context after a restart or a deliberate context roll. Before acting: read any handoff notes left for you on this machine, say plainly what you are and what this node is for, and ask for what you need rather than guessing. Do not assume you have credentials, network peers, or private data; this node may be a clean public install."
      $(resolve_claude) --rc --session-id "$sid" -n "$(cat "$D/$N.title" 2>/dev/null || echo "$N")" "$bp"
    fi
    echo "[claude-persist:$N] claude exited, restarting in 5s"; sleep 5
  done
}
[ "$cmd" = _loop ] && { run_loop "$N"; exit; }

# The tmux SERVER must not live inside whatever service happened to start it.
# There is ONE tmux server per socket, shared by every session, so its cgroup
# is decided by whoever created it first. Twice on 2026-10-06 the server was
# created inside the agent-resume unit's cgroup, and then stopping, restarting
# or renaming that unit killed the server and every live agent with it.
#
# So: if no server is running yet, start it in its OWN transient unit
# (cod-tmux.service) with KillMode=process. After that the unit that calls
# start-all is irrelevant to the agents' survival -- it only ever sends
# new-session to an already-independent server.
ensure() {
  tmux has-session -t "$N" 2>/dev/null && return 0
  cwd_for >/dev/null
  local inner="CLAUDE_BIN='$(resolve_claude)' '$0' _loop '$N'"
  if tmux has-session 2>/dev/null || tmux list-sessions >/dev/null 2>&1; then
    # a server already exists and is already outside this unit's cgroup
    tmux new-session -d -s "$N" -x 200 -y 50 "$inner"
  elif systemctl --user cat cod-tmux.service >/dev/null 2>&1; then
    # A real cod-tmux.service exists, so START IT rather than trying to make a
    # transient unit of the same name — systemd refuses that ("already loaded
    # or has a fragment file") and the fallback then creates the server inside
    # whatever scope the caller happens to be in. Observed on neuralgrid: the
    # server landed in the ssh login session's scope, so it would have died
    # when that ssh connection closed. Same cgroup trap, new disguise.
    systemctl --user start cod-tmux.service >/dev/null 2>&1
    tmux new-session -d -s "$N" -x 200 -y 50 "$inner"
  elif command -v systemd-run >/dev/null 2>&1 && [ -n "${XDG_RUNTIME_DIR:-}" ]; then
    systemd-run --user --quiet --collect \
      --unit=cod-tmux-transient --description="COD tmux server (holds every agent session)" \
      --property=Type=forking --property=KillMode=process --property=RemainAfterExit=yes \
      tmux new-session -d -s "$N" -x 200 -y 50 "$inner" \
    || tmux new-session -d -s "$N" -x 200 -y 50 "$inner"
  else
    tmux new-session -d -s "$N" -x 200 -y 50 "$inner"
  fi
}
# start-all — bring back EVERY registered agent, discovered not hardcoded.
# A reboot should restore whatever was running on this box, whatever it is
# called. Hardcoding one session name means a second agent silently never
# comes back, and nobody notices until they need it.
if [ "$cmd" = start-all ]; then
  found=0
  for f in "$D"/*.sid; do
    [ -e "$f" ] || continue
    N="$(basename "$f" .sid)"
    [[ "$N" =~ ^[A-Za-z0-9_.-]+$ ]] || continue
    found=$((found+1))
    if tmux has-session -t "$N" 2>/dev/null; then
      say "= $N already running"
    else
      say "+ starting $N"
      ensure
    fi
  done
  [ "$found" -gt 0 ] || say "no registered agents in $D (nothing to start)"
  exit 0
fi

case "$cmd" in
  start)  ensure ;;
  stop)   tmux kill-session -t "$N" 2>/dev/null ;;
  status) tmux has-session -t "$N" 2>/dev/null && { echo "$N running (sid $(cat "$D/$N.sid" 2>/dev/null))"; tmux capture-pane -pt "$N" | grep -v "^ *$" | tail -5; } || echo "$N stopped" ;;
  # list — STABLE column order, documented, same on every node:
  #   name <TAB> state <TAB> activity <TAB> cwd <TAB> session-id <TAB> display
  # `activity` is active|idle: idle means the transcript contains no user turns,
  # i.e. nobody has ever typed into this agent. A viewer (the COD app) streams
  # only active ones, otherwise every freshly-registered agent becomes an empty
  # window. Columns were previously ordered differently on different nodes,
  # which forced consumers to guess by shape; don't reorder these again.
  list)
    for f in "$D"/*.sid; do
      [ -e "$f" ] || continue
      n=$(basename "$f" .sid); [ "$n" = _cod_hold ] && continue
      sid=$(cat "$f" 2>/dev/null)
      st=$(tmux has-session -t "$n" 2>/dev/null && echo running || echo stopped)
      cw=$(cat "$D/$n.cwd" 2>/dev/null)
      dn=$(cat "$D/$n.title" 2>/dev/null); [ -n "$dn" ] || dn="$n"
      # activity: "<label>:<user-turn-count>", e.g. active:448 / idle:1
      # HONEST LIMITATION, read this before trusting the label: a boot prompt
      # injected by claude-persist, and a bus message delivered into the pane,
      # both appear in the transcript as user turns. So this CANNOT distinguish
      # "a human typed here" from "something was injected". idle means <=1 turn
      # (just the boot prompt). The COUNT is the useful signal -- threshold it
      # yourself rather than trusting a boolean I cannot compute correctly.
      turns=0
      for t in "$HOME"/.claude/projects/*/"$sid".jsonl; do
        [ -e "$t" ] || continue
        turns=$(grep -c '"type":"user"' "$t" 2>/dev/null || echo 0)
        break
      done
      if [ "${turns:-0}" -le 1 ]; then act="idle:${turns:-0}"; else act="active:$turns"; fi
      printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$n" "$st" "$act" "$cw" "$sid" "$dn"
    done ;;
  reset)  rm -f "$D/$N.sid" ;;
  # restart — bounce ONLY the inner claude, never the tmux session. Killing the
  # session would drop the agent the Claude app is remote-controlling. The sid
  # is kept, so the loop relaunches in ~5s and RESUMES the same context.
  restart|fresh)
    ensure
    [ "$cmd" = fresh ] && rm -f "$D/$N.sid"   # drop the pin => new context
    pane=$(tmux display-message -p -t "$N":0 '#{pane_pid}' 2>/dev/null)
    [ -n "$pane" ] && pkill -P "$pane" 2>/dev/null
    echo "$(date -Is) $cmd $N (pane ${pane:-none})" >> "$HOME/.local/share/claude-persist.log"
    ;;
  attach) ensure; exec tmux attach -t "$N" ;;
  # stream — what an external viewer (the COD app) should call.
  # Differs from `attach` in three ways that matter:
  #   1. It NEVER creates. `attach` calls ensure(), so a viewer attaching to a
  #      typo or a dead agent would silently spawn a new agent. A viewer must
  #      not be able to create agents.
  #   2. It joins as a GROUPED session (`new-session -t`), so each viewer gets
  #      its own size. Plain `attach` clamps the window to the smallest client,
  #      so one phone viewing would shrink the agent's view for everybody.
  #   3. It refuses the internal holder session.
  stream)
    case "$N" in _cod_hold) echo "refusing: _cod_hold is the internal tmux holder, not an agent" >&2; exit 2 ;; esac
    tmux has-session -t "$N" 2>/dev/null || { echo "no live agent session '$N' on $(hostname)" >&2; exit 1; }
    # No destroy-unattached: if that option ever landed on the ORIGINAL
    # session instead of the viewer's, detaching would kill a live agent.
    # An orphaned viewer session is harmless clutter; a dead agent is not.
    exec tmux new-session -A -t "$N"
    ;;
esac
